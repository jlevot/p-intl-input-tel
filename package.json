{
  "name": "p-intl-input-tel",
  "version": "20.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "jest --coverage",
    "test-ci": "jest --runInBand",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build_stats": "ng build --stats-json",
    "analyze": "webpack-bundle-analyzer dist/p-intl-input-tel-app/stats.json",
    "build_lib": "ng build p-intl-input-tel",
    "copy-license": "cp ./LICENSE ./dist/p-intl-input-tel",
    "copy-readme": "cp ./README.md ./dist/p-intl-input-tel",
    "copy-files": "npm run copy-license && npm run copy-readme",
    "npm_pack": "npm run copy-files && cd dist/p-intl-input-tel && npm pack",
    "create-link": "cd dist/p-intl-input-tel && npm link",
    "package": "npm run build_lib && npm run npm_pack"
  },
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "@typescript-eslint/types": "^8.0.0",
    "core-js": "^3.32.0",
    "google-libphonenumber": "^3.2.42",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/language-service": "^22.2.0",
    "@eslint/js": "^9.39.5",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.4.9",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.5",
    "jest": "^30.3.0",
    "jest-preset-angular": "^17.0.0",
    "ng-packagr": "^22.2.1",
    "prettier": "^3.6.2",
    "ts-node": "~10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "webpack-bundle-analyzer": "^4.9.0"
  }
}
